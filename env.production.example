# 1. APPLICATION ENVIRONMENT
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://sales.goldia.uz

# 2. SUPABASE PRODUCTION API (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://vrozlilcaxinavzxueif.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_PROD_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_PROD_SERVICE_ROLE_KEY

# 3. DIRECT POSTGRESQL CONNECTION (Supabase Dashboard -> Project Settings -> Database)
# Format: postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Eslatma: Parol loyiha yaratilganda kiritilgan ma'lumotlar bazasi paroli (DB Password).
