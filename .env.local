# =========================================================================
# JewelryFlow ERP — Environment Variables
# Copy to .env.local (Next.js dev) and to your hosting provider's secret
# store for production. Never commit the populated file.
# =========================================================================

# Public — exposed to the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used exclusively inside Route Handlers / Server Actions /
# Server Components that need to bypass RLS (e.g. system reports, cron
# jobs). Never import this in a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://hbbuskyifxkowlozsaym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Rih3VDa7l37H-N0hZMkuZg_WyDEzBIp

