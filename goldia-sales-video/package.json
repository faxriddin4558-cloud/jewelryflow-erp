{
  "name": "goldia-sales-video",
  "version": "1.0.0",
  "private": true,
  "description": "Goldia Sales — direktor uchun video-prezentatsiya (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render:test": "remotion render src/index.ts GoldiaTest out/goldia-test-10s.mp4",
    "render": "remotion render src/index.ts GoldiaSales out/goldia-sales.mp4",
    "srt": "node scripts/make-srt.mjs",
    "typecheck": "tsc --noEmit",
    "audio:scan": "node scripts/scan-audio.mjs",
    "music": "node scripts/make-music.mjs 230",
    "voice": "python3 scripts/build_voice.py",
    "render:real": "remotion render src/index.ts GoldiaReal out/goldia-sales-real.mp4",
    "render:real-test": "remotion render src/index.ts GoldiaRealTest out/goldia-real-test-voice.mp4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "^4.0.539",
    "@remotion/transitions": "^4.0.539",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^5.9.3"
  }
}
